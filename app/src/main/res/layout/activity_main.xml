<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/homeGroup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingHorizontal="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:maxWidth="560dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="4dp"
                android:paddingVertical="8dp">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_tile"
                    app:tint="?attr/colorPrimary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"
                        android:textAppearance="?attr/textAppearanceHeadlineSmall" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_tagline"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnPick"
                    style="@style/HomeActionCard"
                    android:layout_marginEnd="6dp"
                    app:cardBackgroundColor="?attr/colorPrimary">

                    <LinearLayout style="@style/HomeActionContent">

                        <ImageView
                            style="@style/HomeActionIcon"
                            android:src="@drawable/ic_image"
                            app:tint="?attr/colorOnPrimary" />

                        <TextView
                            style="@style/HomeActionLabel"
                            android:text="@string/pick_image"
                            android:textColor="?attr/colorOnPrimary" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnScreenshot"
                    style="@style/HomeActionCard"
                    android:layout_marginStart="6dp"
                    app:cardBackgroundColor="?attr/colorSecondaryContainer">

                    <LinearLayout style="@style/HomeActionContent">

                        <ImageView
                            style="@style/HomeActionIcon"
                            android:src="@drawable/ic_tile"
                            app:tint="?attr/colorOnSecondaryContainer" />

                        <TextView
                            style="@style/HomeActionLabel"
                            android:text="@string/latest_screenshot"
                            android:textColor="?attr/colorOnSecondaryContainer" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <TextView
                android:id="@+id/setupHeader"
                style="@style/HomeSectionHeader"
                android:text="@string/section_setup" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/setupCard"
                style="@style/HomeCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/btnEnableCapture"
                        style="@style/HomeRow">

                        <ImageView style="@style/HomeRowIcon" android:src="@drawable/ic_bolt" />

                        <LinearLayout style="@style/HomeRowText">

                            <TextView style="@style/HomeRowTitle" android:text="@string/enable_instant_capture" />

                            <TextView style="@style/HomeRowSummary" android:text="@string/enable_instant_capture_summary" />
                        </LinearLayout>

                        <ImageView style="@style/HomeRowChevron" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btnSetAssistant"
                        style="@style/HomeRow">

                        <ImageView style="@style/HomeRowIcon" android:src="@drawable/ic_mic" />

                        <LinearLayout style="@style/HomeRowText">

                            <TextView style="@style/HomeRowTitle" android:text="@string/set_as_assistant" />

                            <TextView style="@style/HomeRowSummary" android:text="@string/set_as_assistant_summary" />
                        </LinearLayout>

                        <ImageView style="@style/HomeRowChevron" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/HomeSectionHeader"
                android:text="@string/section_translation" />

            <com.google.android.material.card.MaterialCardView style="@style/HomeCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/rowTargetLanguage"
                        style="@style/HomeRow">

                        <ImageView style="@style/HomeRowIcon" android:src="@drawable/ic_translate" />

                        <LinearLayout style="@style/HomeRowText">

                            <TextView style="@style/HomeRowTitle" android:text="@string/translate_to" />

                            <TextView
                                android:id="@+id/textTargetLanguage"
                                style="@style/HomeRowSummary" />
                        </LinearLayout>

                        <ImageView style="@style/HomeRowChevron" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/rowEngine"
                        style="@style/HomeRow">

                        <ImageView style="@style/HomeRowIcon" android:src="@drawable/ic_settings" />

                        <LinearLayout style="@style/HomeRowText">

                            <TextView style="@style/HomeRowTitle" android:text="@string/engine_title" />

                            <TextView
                                android:id="@+id/textEngine"
                                style="@style/HomeRowSummary" />
                        </LinearLayout>

                        <ImageView style="@style/HomeRowChevron" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/rowLanguagePacks"
                        style="@style/HomeRow">

                        <ImageView style="@style/HomeRowIcon" android:src="@drawable/ic_download" />

                        <LinearLayout style="@style/HomeRowText">

                            <TextView style="@style/HomeRowTitle" android:text="@string/language_packs" />

                            <TextView
                                android:id="@+id/textLanguagePacks"
                                style="@style/HomeRowSummary" />
                        </LinearLayout>

                        <ImageView style="@style/HomeRowChevron" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/HomeSectionHeader"
                android:text="@string/section_more" />

            <com.google.android.material.card.MaterialCardView style="@style/HomeCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        style="@style/HomeRow"
                        android:background="@null"
                        android:clickable="false">

                        <ImageView style="@style/HomeRowIcon" android:src="@drawable/ic_info" />

                        <LinearLayout style="@style/HomeRowText">

                            <TextView style="@style/HomeRowSummary" android:text="@string/home_hint" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/adbRow"
                        style="@style/HomeRow"
                        android:contentDescription="@string/adb_copy">

                        <ImageView style="@style/HomeRowIcon" android:src="@drawable/ic_code" />

                        <LinearLayout style="@style/HomeRowText">

                            <TextView style="@style/HomeRowTitle" android:text="@string/adb_label" />

                            <TextView
                                android:id="@+id/adbCommand"
                                style="@style/HomeRowSummary"
                                android:layout_marginTop="4dp"
                                android:fontFamily="monospace"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <ImageView
                            style="@style/HomeRowChevron"
                            android:src="@drawable/ic_copy" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="@string/home_subtitle"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:id="@+id/viewerGroup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        tools:visibility="visible">

        <com.arslan.textgrab.SelectableOcrView
            android:id="@+id/ocrView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:background="@drawable/top_scrim">

            <ImageButton
                android:id="@+id/btnBack"
                style="@style/ViewerIconButton"
                android:contentDescription="@string/back"
                android:src="@drawable/ic_back" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btnSelectAll"
                style="@style/ViewerIconButton"
                android:contentDescription="@string/select_all"
                android:src="@drawable/ic_select_all" />

            <ImageButton
                android:id="@+id/btnTextMode"
                style="@style/ViewerIconButton"
                android:contentDescription="@string/view_as_text"
                android:src="@drawable/ic_text" />

            <ImageButton
                android:id="@+id/btnTranslateAll"
                style="@style/ViewerIconButton"
                android:contentDescription="@string/translate"
                android:src="@drawable/ic_translate" />

            <ImageButton
                android:id="@+id/btnCopyAll"
                style="@style/ViewerIconButton"
                android:contentDescription="@string/copy_all"
                android:src="@drawable/ic_copy" />

            <ImageButton
                android:id="@+id/btnShareAll"
                style="@style/ViewerIconButton"
                android:contentDescription="@string/share"
                android:src="@drawable/ic_share" />
        </LinearLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/ocrProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorColor="?attr/colorPrimary"
            app:trackColor="@android:color/transparent"
            app:trackThickness="3dp"
            tools:visibility="visible" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/selectionToolbar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:visibility="gone"
            app:cardCornerRadius="24dp"
            app:cardElevation="6dp"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="6dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/toolbarCopy"
                    style="@style/ToolbarTextButton"
                    android:text="@string/copy" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/toolbarSelectAll"
                    style="@style/ToolbarTextButton"
                    android:text="@string/select_all_short" />

                <ImageButton
                    android:id="@+id/toolbarShare"
                    style="@style/ToolbarIconButton"
                    android:contentDescription="@string/share"
                    android:src="@drawable/ic_share" />

                <ImageButton
                    android:id="@+id/toolbarSearch"
                    style="@style/ToolbarIconButton"
                    android:contentDescription="@string/search_web"
                    android:src="@drawable/ic_search" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/progressGroup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:colorBackground"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        tools:visibility="gone">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            app:indicatorSize="36dp"
            app:trackThickness="3dp" />
    </FrameLayout>
</FrameLayout>
