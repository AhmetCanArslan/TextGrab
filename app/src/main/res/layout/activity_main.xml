<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/homeGroup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingHorizontal="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:maxWidth="560dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp"
                android:paddingVertical="8dp">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_tile"
                    app:tint="?attr/colorPrimary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"
                        android:textAppearance="?attr/textAppearanceHeadlineSmallEmphasized" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_tagline"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButtonGroup
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPick"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/pick_image"
                    app:icon="@drawable/ic_image"
                    app:iconGravity="textStart"
                    app:materialSizeOverlay="@style/SizeOverlay.Material3Expressive.Button.Medium" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnScreenshot"
                    style="?attr/materialButtonTonalStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/latest_screenshot"
                    app:icon="@drawable/ic_tile"
                    app:iconGravity="textStart"
                    app:materialSizeOverlay="@style/SizeOverlay.Material3Expressive.Button.Medium" />
            </com.google.android.material.button.MaterialButtonGroup>

            <TextView
                android:id="@+id/setupHeader"
                style="@style/HomeSectionHeader"
                android:text="@string/section_setup" />

            <LinearLayout
                android:id="@+id/setupCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.listitem.ListItemCardView
                    android:id="@+id/btnEnableCapture"
                    style="@style/ListItemCard">

                    <LinearLayout style="@style/ListItemRow">

                        <ImageView
                            style="@style/ListItemLeadingIcon"
                            android:src="@drawable/ic_bolt" />

                        <LinearLayout style="@style/ListItemTextGroup">

                            <TextView
                                style="@style/ListItemLabel"
                                android:text="@string/enable_instant_capture" />

                            <TextView
                                style="@style/ListItemSupportingText"
                                android:text="@string/enable_instant_capture_summary" />
                        </LinearLayout>

                        <ImageView
                            style="@style/ListItemTrailingIcon"
                            android:src="@drawable/ic_chevron_right" />
                    </LinearLayout>
                </com.google.android.material.listitem.ListItemCardView>

                <com.google.android.material.listitem.ListItemCardView
                    android:id="@+id/btnSetAssistant"
                    style="@style/ListItemCard">

                    <LinearLayout style="@style/ListItemRow">

                        <ImageView
                            style="@style/ListItemLeadingIcon"
                            android:src="@drawable/ic_mic" />

                        <LinearLayout style="@style/ListItemTextGroup">

                            <TextView
                                style="@style/ListItemLabel"
                                android:text="@string/set_as_assistant" />

                            <TextView
                                style="@style/ListItemSupportingText"
                                android:text="@string/set_as_assistant_summary" />
                        </LinearLayout>

                        <ImageView
                            style="@style/ListItemTrailingIcon"
                            android:src="@drawable/ic_chevron_right" />
                    </LinearLayout>
                </com.google.android.material.listitem.ListItemCardView>
            </LinearLayout>

            <TextView
                style="@style/HomeSectionHeader"
                android:text="@string/section_translation" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.listitem.ListItemCardView
                    android:id="@+id/rowTargetLanguage"
                    style="@style/ListItemCard"
                    app:shapeAppearance="@style/ShapeAppearance.Material3.ListItem.First">

                    <LinearLayout style="@style/ListItemRow">

                        <ImageView
                            style="@style/ListItemLeadingIcon"
                            android:src="@drawable/ic_translate" />

                        <LinearLayout style="@style/ListItemTextGroup">

                            <TextView
                                style="@style/ListItemLabel"
                                android:text="@string/translate_to" />

                            <TextView
                                android:id="@+id/textTargetLanguage"
                                style="@style/ListItemSupportingText" />
                        </LinearLayout>

                        <ImageView
                            style="@style/ListItemTrailingIcon"
                            android:src="@drawable/ic_chevron_right" />
                    </LinearLayout>
                </com.google.android.material.listitem.ListItemCardView>

                <com.google.android.material.listitem.ListItemCardView
                    android:id="@+id/rowEngine"
                    style="@style/ListItemCard"
                    app:shapeAppearance="@style/ShapeAppearance.Material3.ListItem.Middle">

                    <LinearLayout style="@style/ListItemRow">

                        <ImageView
                            style="@style/ListItemLeadingIcon"
                            android:src="@drawable/ic_settings" />

                        <LinearLayout style="@style/ListItemTextGroup">

                            <TextView
                                style="@style/ListItemLabel"
                                android:text="@string/engine_title" />

                            <TextView
                                android:id="@+id/textEngine"
                                style="@style/ListItemSupportingText" />
                        </LinearLayout>

                        <ImageView
                            style="@style/ListItemTrailingIcon"
                            android:src="@drawable/ic_chevron_right" />
                    </LinearLayout>
                </com.google.android.material.listitem.ListItemCardView>

                <com.google.android.material.listitem.ListItemCardView
                    android:id="@+id/rowLanguagePacks"
                    style="@style/ListItemCard"
                    app:shapeAppearance="@style/ShapeAppearance.Material3.ListItem.Last">

                    <LinearLayout style="@style/ListItemRow">

                        <ImageView
                            style="@style/ListItemLeadingIcon"
                            android:src="@drawable/ic_download" />

                        <LinearLayout style="@style/ListItemTextGroup">

                            <TextView
                                style="@style/ListItemLabel"
                                android:text="@string/language_packs" />

                            <TextView
                                android:id="@+id/textLanguagePacks"
                                style="@style/ListItemSupportingText" />
                        </LinearLayout>

                        <ImageView
                            style="@style/ListItemTrailingIcon"
                            android:src="@drawable/ic_chevron_right" />
                    </LinearLayout>
                </com.google.android.material.listitem.ListItemCardView>
            </LinearLayout>

            <TextView
                style="@style/HomeSectionHeader"
                android:text="@string/section_more" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.listitem.ListItemCardView
                    style="@style/ListItemCard"
                    android:clickable="false"
                    android:focusable="false"
                    app:shapeAppearance="@style/ShapeAppearance.Material3.ListItem.First">

                    <LinearLayout style="@style/ListItemRow">

                        <ImageView
                            style="@style/ListItemLeadingIcon"
                            android:src="@drawable/ic_info" />

                        <LinearLayout style="@style/ListItemTextGroup">

                            <TextView
                                style="@style/ListItemSupportingText"
                                android:text="@string/home_hint" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.listitem.ListItemCardView>

                <com.google.android.material.listitem.ListItemCardView
                    android:id="@+id/adbRow"
                    style="@style/ListItemCard"
                    android:contentDescription="@string/adb_copy"
                    app:shapeAppearance="@style/ShapeAppearance.Material3.ListItem.Last">

                    <LinearLayout style="@style/ListItemRow">

                        <ImageView
                            style="@style/ListItemLeadingIcon"
                            android:src="@drawable/ic_code" />

                        <LinearLayout style="@style/ListItemTextGroup">

                            <TextView
                                style="@style/ListItemLabel"
                                android:text="@string/adb_label" />

                            <TextView
                                android:id="@+id/adbCommand"
                                style="@style/ListItemSupportingText"
                                android:layout_marginTop="4dp"
                                android:fontFamily="monospace" />
                        </LinearLayout>

                        <ImageView
                            style="@style/ListItemTrailingIcon"
                            android:src="@drawable/ic_copy" />
                    </LinearLayout>
                </com.google.android.material.listitem.ListItemCardView>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="@string/home_subtitle"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:id="@+id/viewerGroup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        tools:visibility="visible">

        <com.arslan.textgrab.SelectableOcrView
            android:id="@+id/ocrView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.google.android.material.floatingtoolbar.FloatingToolbarLayout
            android:id="@+id/topBar"
            style="@style/Widget.Material3.FloatingToolbar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_margin="8dp"
            app:marginLeftSystemWindowInsets="true"
            app:marginRightSystemWindowInsets="true"
            app:marginTopSystemWindowInsets="true">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBack"
                    style="?attr/materialIconButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/back"
                    app:icon="@drawable/ic_back" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSelectAll"
                    style="?attr/materialIconButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/select_all"
                    app:icon="@drawable/ic_select_all" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTextMode"
                    style="?attr/materialIconButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/view_as_text"
                    app:icon="@drawable/ic_text" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTranslateAll"
                    style="?attr/materialIconButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:contentDescription="@string/translate"
                    app:icon="@drawable/ic_translate" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCopyAll"
                    style="?attr/materialIconButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/copy_all"
                    app:icon="@drawable/ic_copy" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShareAll"
                    style="?attr/materialIconButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/share"
                    app:icon="@drawable/ic_share" />
            </LinearLayout>
        </com.google.android.material.floatingtoolbar.FloatingToolbarLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/ocrProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:indeterminate="true"
            android:visibility="gone"
            app:waveAmplitude="2dp"
            app:wavelength="24dp"
            tools:visibility="visible" />

        <com.google.android.material.floatingtoolbar.FloatingToolbarLayout
            android:id="@+id/selectionToolbar"
            style="@style/Widget.Material3.FloatingToolbar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/toolbarCopy"
                    style="?attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/copy" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/toolbarSelectAll"
                    style="?attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/select_all_short" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/toolbarShare"
                    style="?attr/materialIconButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/share"
                    app:icon="@drawable/ic_share" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/toolbarSearch"
                    style="?attr/materialIconButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/search_web"
                    app:icon="@drawable/ic_search" />
            </LinearLayout>
        </com.google.android.material.floatingtoolbar.FloatingToolbarLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/progressGroup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        tools:visibility="gone">

        <com.google.android.material.loadingindicator.LoadingIndicator
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />
    </FrameLayout>
</FrameLayout>
