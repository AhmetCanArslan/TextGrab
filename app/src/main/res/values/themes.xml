<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.TextGrab" parent="Theme.Material3Expressive.DynamicColors.DayNight.NoActionBar" />

    <style name="Theme.TextGrab.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/window_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="postSplashScreenTheme">@style/Theme.TextGrab</item>
    </style>

    <style name="HomeSectionHeader" parent="Widget.Material3.TextView.ListItem.Overline">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:paddingHorizontal">16dp</item>
    </style>

    <style name="ListItemCard" parent="Widget.Material3.ListItemCardView.Segmented">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">2dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerHigh</item>
    </style>

    <style name="ListItemRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="ListItemLeadingIcon" parent="Widget.Material3.ImageView.ListItem.LeadingIcon">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
    </style>

    <style name="ListItemTrailingIcon" parent="Widget.Material3.ImageView.ListItem.TrailingIcon">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:layout_marginStart">8dp</item>
    </style>

    <style name="ListItemTextGroup">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="ListItemLabel" parent="Widget.Material3.TextView.ListItem.LabelText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <style name="ListItemSupportingText" parent="Widget.Material3.TextView.ListItem.SupportingText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
    </style>
</resources>
